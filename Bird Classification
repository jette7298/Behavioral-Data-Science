drop=True)\n\n# cap\nimages_df = (\n    images_df.groupby(\"primary_label\", group_keys=False)\n    .apply(lambda x: x.sample(n=min(len(x), MAX_SEGMENTS_PER_BIRD), random_state=42))\n    .reset_index(drop=True)\n)\n\ncounts = images_df[\"primary_label\"].value_counts()\nprint(\"Min segments per bird:\", counts.min())\nprint(\"Max segments per bird:\", counts.max())\nassert counts.min() >= MIN_SEGMENTS_PER_BIRD\nassert counts.max() <= MAX_SEGMENTS_PER_BIRD","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-21T09:36:37.223245Z","iopub.execute_input":"2025-12-21T09:36:37.223777Z","iopub.status.idle":"2025-12-21T09:36:37.623030Z","shell.execute_reply.started":"2025-12-21T09:36:37.223754Z","shell.execute_reply":"2025-12-21T09:36:37.622206Z"}},"outputs":[{"name":"stdout","text":"Min segments per bird: 39\nMax segments per bird: 3000\n","output_type":"stream"},{"name":"stderr","text":"/tmp/ipykernel_47/2452852646.py:13: DeprecationWarning: DataFrameGroupBy.apply operated on the grouping columns. This behavior is deprecated, and in a future version of pandas the grouping columns will be excluded from the operation. Either pass `include_groups=False` to exclude the groupings or explicitly select the grouping columns after groupby to silence this warning.\n  .apply(lambda x: x.sample(n=min(len(x), MAX_SEGMENTS_PER_BIRD), random_state=42))\n","output_type":"stream"}],"execution_count":32},{"cell_type":"markdown","source":"## 2.3.3 Randomily keeping 25% of species\n\nAs we experienced issues with working memory we decided to cap the number of pictures with the code below.","metadata":{}},{"cell_type":"code","source":"# keep random 25% of species\n\nrng = np.random.RandomState(42)\nall_species = images_df[\"primary_label\"].unique()\nhalf_species = rng.choice(all_species, size=len(all_species)//8, replace=False)\n\nimages_df = images_df[images_df[\"primary_label\"].isin(half_species)].reset_index(drop=True)\n\nprint(\"Kept species:\", images_df[\"primary_label\"].nunique(), \"of\", len(all_species))\nprint(\"Kept rows:\", len(images_df))\nassert images_df[\"primary_label\"].nunique() == len(half_species)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-21T09:36:41.703117Z","iopub.execute_input":"2025-12-21T09:36:41.703406Z","iopub.status.idle":"2025-12-21T09:36:41.772755Z","shell.execute_reply.started":"2025-12-21T09:36:41.703382Z","shell.execute_reply":"2025-12-21T09:36:41.772102Z"}},"outputs":[{"name":"stdout","text":"Kept species: 49 of 397\nKept rows: 54171\n","output_type":"stream"}],"execution_count":33},{"cell_type":"markdown","source":"## 2.3.4 Build no-call class\n\nWe know from a working paper (Kahl et al, 2021) that the baseline would be no-call at around 48%. However in the training data there is no no-call category so far. That is why we tried labelling a new class here, where we define the 48% of the spectograms with the lowest energy as no-call.This idea was inspired from this report: https://medium.com/@maxme006/how-i-climbed-to-the-top-2-in-birdclef-2025-every-failure-every-lesson-and-why-details-matter-273d781a33df\n\nFirstly we generated a histogram showing the distributions of the energies. However this resulted in a nearly perfectly normal distribution, definetly not showing a clear cutoff value, which already casted some doubts to that approach. Secondly we ran the model twice with 2 different baselines. Both tries resulted in accuracies exactly equalling the baseline.\n\nThat is why in the end we decided not to define a no-call class, as we concluded that this just resulted in the model learning how to identify said no-call class, but not actual bird species. Furthermore, we were in a bit of doubt, if this approach could not be classified as fraud, because with our approach we did not only had to mutate the trainings set, bot also the test and validation set(as we had no access to the orignial test set which contains no-call labeling, we kept a part of our trainings set apart for later testing).","metadata":{}},{"cell_type":"code","source":"# define energy function\n\ndef energy_score_segment(row) -> float:\n    arr = np.load(row[\"filepath\"], mmap_mode=\"r\")\n    seg = arr[int(row[\"segment_idx\"])]           # (128,281)\n    return float(np.mean(np.abs(seg)))\n\n# compute energies (segment-level)\nimages_df = images_df.copy()\nimages_df[\"energy\"] = images_df.apply(energy_score_segment, axis=1)\n\nprint(images_df[\"energy\"].describe())\n\n# histogram\nplt.figure()\nplt.hist(images_df[\"energy\"], bins=50)\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-21T09:37:10.962724Z","iopub.execute_input":"2025-12-21T09:37:10.963180Z","iopub.status.idle":"2025-12-21T09:38:54.870431Z","shell.execute_reply.started":"2025-12-21T09:37:10.963160Z","shell.execute_reply":"2025-12-21T09:38:54.869827Z"}},"outputs":[{"name":"stdout","text":"count    54171.000000\nmean        96.467042\nstd         30.352823\nmin          0.000000\n25%         75.220793\n50%         94.657835\n75%        116.260078\nmax        215.065920\nName: energy, dtype: float64\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":34},{"cell_type":"code","source":"# # define fraction for no call\n# NO_CALL_FRAC = 0.00 # here the fraction could be changed\n# n_nocall = int(len(images_df) * NO_CALL_FRAC)\n# print(\"Will create nocall samples:\", n_nocall)\n# \n# # select lowest energy segment and relabel as no call\n# nocall_df = images_df.nsmallest(n_nocall, \"energy\").copy()\n# nocall_df[\"primary_label\"] = \"nocall\"\n# \n# # remove those rows from the set\n# bird_df = images_df.drop(index=nocall_df.index).copy()\n# \n# # combine and check\n# final_df = pd.concat([bird_df, nocall_df], ignore_index=True)\n# \n# print(\"Classes:\", final_df[\"primary_label\"].nunique())\n# print(final_df[\"primary_label\"].value_counts().head(10))\n# print(\"nocall share:\", (final_df[\"primary_label\"]==\"nocall\").mean())","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# run this instead if there is no no-call class\nfinal_df = images_df","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-21T09:39:25.767414Z","iopub.execute_input":"2025-12-21T09:39:25.768063Z","iopub.status.idle":"2025-12-21T09:39:25.771105Z","shell.execute_reply.started":"2025-12-21T09:39:25.768042Z","shell.execute_reply":"2025-12-21T09:39:25.770535Z"}},"outputs":[],"execution_count":38},{"cell_type":"markdown","source":"## 2.3.5 Splitting into training, validation, and test sets\n\nAs we had no access to the oringinal test set, we used our training set to manually generate a validation and test dataset.\n\n@ChatGPT helped in this part, as we had a data leakage problem in an earlier version to prevent that.","metadata":{}},{"cell_type":"code","source":"# 1. Split by recording_id (The Fix)\n# We use GroupShuffleSplit on 'final_df' so segments from the same recording stay together.\n\n# Split Train (80%) vs Temp (20%)\ngss = GroupShuffleSplit(test_size=0.2, random_state=42)\ntrain_idx, temp_idx = next(gss.split(final_df, groups=final_df[\"recording_id\"]))\n\ntrain_df = final_df.iloc[train_idx].reset_index(drop=True)\ntemp_df = final_df.iloc[temp_idx].reset_index(drop=True)\n\n# Split Temp into Val (50%) and Test (50%)\ngss2 = GroupShuffleSplit(test_size=0.5, random_state=42)\nval_idx, test_idx = next(gss2.split(temp_df, groups=temp_df[\"recording_id\"]))\n\nval_df = temp_df.iloc[val_idx].reset_index(drop=True)\ntest_df = temp_df.iloc[test_idx].reset_index(drop=True)\n\n# 2. Verify no leakage \n\n# we had this problem in an earlier version, which is why we explicetly check for it here\n# Check if any recording ID exists in both Train and Val\ntrain_recs = set(train_df[\"recording_id\"])\nval_recs = set(val_df[\"recording_id\"])\ntest_recs = set(test_df[\"recording_id\"])\n\nassert train_recs.isdisjoint(val_recs), \"DATA LEAKAGE DETECTED: Train and Val share recordings!\"\nassert train_recs.isdisjoint(test_recs), \"DATA LEAKAGE DETECTED: Train and Test share recordings!\"\nprint(\"✅ Verification Passed: No recording overlap.\")\n\n# 3. Prepare X and y arrays\nX_train = train_df[\"filepath\"].values\nX_val   = val_df[\"filepath\"].values\nX_test  = test_df[\"filepath\"].values\n\n# 4. Encode labels\n# We fit the encoder on ALL data to ensure we know all classes\nlabel_encoder = LabelEncoder()\nlabel_encoder.fit(final_df[\"primary_label\"])\n\ny_train = label_encoder.transform(train_df[\"primary_label\"])\ny_val   = label_encoder.transform(val_df[\"primary_label\"])\ny_test  = label_encoder.transform(test_df[\"primary_label\"])\n\n# 5. Oene-hot encod (Required for CategoricalCrossentropy in ResNet)\nnum_classes = len(label_encoder.classes_)\n\ny_train_oh = tf.keras.utils.to_categorical(y_train, num_classes=num_classes)\ny_val_oh   = tf.keras.utils.to_categorical(y_val, num_classes=num_classes)\ny_test_oh  = tf.keras.utils.to_categorical(y_test, num_classes=num_classes)\n\n#6. Add labels\ntrain_df[\"label\"] = y_train\nval_df[\"label\"]   = y_val\ntest_df[\"label\"]  = y_test\n\n\n# 7. Print stats\nprint(f\"\\nTraining Samples: {len(X_train)}\")\nprint(f\"Validation Samples: {len(X_val)}\")\nprint(f\"Test Samples: {len(X_test)}\")\nprint(f\"Number of Classes: {num_classes}\")\nprint(f\"Shapes for ResNet: X {X_train.shape}, y {y_train_oh.shape}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-21T09:39:28.176920Z","iopub.execute_input":"2025-12-21T09:39:28.177566Z","iopub.status.idle":"2025-12-21T09:39:28.258424Z","shell.execute_reply.started":"2025-12-21T09:39:28.177544Z","shell.execute_reply":"2025-12-21T09:39:28.257789Z"}},"outputs":[{"name":"stdout","text":"✅ Verification Passed: No recording overlap.\n\nTraining Samples: 43340\nValidation Samples: 5377\nTest Samples: 5454\nNumber of Classes: 49\nShapes for ResNet: X (43340,), y (43340, 49)\n","output_type":"stream"}],"execution_count":39},{"cell_type":"code","source":"# inspect a few samples\nfor p in X_train[:5]:\n    arr = np.load(p, mmap_mode=\"r\")\n    print(p, arr.shape, arr.dtype)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 2.3.6 Define function to get the right shape\n\nEach audio file was split into individual segments and stored in a segment-level DataFrame with file paths, segment indices, and labels. Segments are loaded on-the-fly, converted to 3-channel arrays, and resized to 224×224 pixels for CNN input. TensorFlow datasets are then created with batching, shuffling (for training), and prefetching for efficient model training and evaluation. These helper functions facilitated consistent preprocessing and ensured that the input data was compatible with all network architectures.\n\nCredits to @ChatGPT for its help in this part to get the melspectra in the right format.","metadata":{}},{"cell_type":"code","source":"IMG_SIZE = 224 #target spatial resolution\nBATCH_SIZE = 32 \n\n# there are different numbers of segments per file, \n# so we expand them --> get a segment-level dataframe\ndef expand_to_segments(df, path_col=\"filepath\", label_col=\"label\"):\n    rows = []\n    for p, y in zip(df[path_col].values, df[label_col].values):\n        arr = np.load(p, mmap_mode=\"r\")\n        nseg = arr.shape[0]\n        rows.extend([(p, s, int(y)) for s in range(nseg)])\n    return pd.DataFrame(rows, columns=[path_col, \"segment\", label_col])\n\n#apply\ntrain_seg_df = expand_to_segments(train_df, path_col=\"filepath\", label_col=\"label\")\nval_seg_df   = expand_to_segments(val_df,   path_col=\"filepath\", label_col=\"label\")\ntest_seg_df  = expand_to_segments(test_df,  path_col=\"filepath\", label_col=\"label\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-21T09:39:32.895428Z","iopub.execute_input":"2025-12-21T09:39:32.896050Z","iopub.status.idle":"2025-12-21T09:41:06.481985Z","shell.execute_reply.started":"2025-12-21T09:39:32.896027Z","shell.execute_reply":"2025-12-21T09:41:06.481212Z"}},"outputs":[],"execution_count":40},{"cell_type":"code","source":"# loads one segment from a .npy file \ndef load_npy(path_bytes, segment_idx):\n    path = path_bytes.decode(\"utf-8\") # Converts TensorFlow string tensor → Python string\n    seg  = int(segment_idx) # Converts index tensor → Python int\n\n    x = np.load(path, mmap_mode=\"r\")[seg]    # (128, 281)\n\n    x = x[..., None]                         # (128, 281, 1)\n    x = np.repeat(x, 3, axis=-1)             # (128, 281, 3)\n\n    return x.astype(np.float32)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-21T09:41:33.249785Z","iopub.execute_input":"2025-12-21T09:41:33.250044Z","iopub.status.idle":"2025-12-21T09:41:33.256110Z","shell.execute_reply.started":"2025-12-21T09:41:33.250024Z","shell.execute_reply":"2025-12-21T09:41:33.254714Z"}},"outputs":[],"execution_count":41},{"cell_type":"code","source":"#wraps previously build function,so that it can be used with tensorflow\n\ndef tf_load_npy(path, segment_idx, label):\n    x = tf.numpy_function(\n        load_npy,\n        [path, segment_idx],\n        tf.float32\n    )\n    x.set_shape([None, None, 3])\n\n    x = tf.image.resize(x, (IMG_SIZE, IMG_SIZE)) # resizes to CNN input\n    return x, label","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-21T09:41:35.668733Z","iopub.execute_input":"2025-12-21T09:41:35.668989Z","iopub.status.idle":"2025-12-21T09:41:35.673722Z","shell.execute_reply.started":"2025-12-21T09:41:35.668969Z","shell.execute_reply":"2025-12-21T09:41:35.672909Z"}},"outputs":[],"execution_count":42},{"cell_type":"code","source":"#dataset construction\n\ndef make_ds(df, training):\n    paths    = df[\"filepath\"].values\n    segments = df[\"segment\"].values.astype(np.int32)\n    labels   = df[\"label\"].values.astype(np.int32)\n\n    ds = tf.data.Dataset.from_tensor_slices((paths, segments, labels))\n\n    def _load(path, seg, y):\n        x = tf.numpy_function(load_npy, [path, seg], tf.float32)\n        x.set_shape((128, 281, 3))\n        return x, y\n\n    ds = ds.map(_load, num_parallel_calls=tf.data.AUTOTUNE)\n    if training:\n        ds = ds.shuffle(2048, reshuffle_each_iteration=True)\n    return ds.batch(BATCH_SIZE).prefetch(tf.data.AUTOTUNE)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-21T09:41:38.590801Z","iopub.execute_input":"2025-12-21T09:41:38.591472Z","iopub.status.idle":"2025-12-21T09:41:38.596626Z","shell.execute_reply.started":"2025-12-21T09:41:38.591448Z","shell.execute_reply":"2025-12-21T09:41:38.595867Z"}},"outputs":[],"execution_count":43},{"cell_type":"markdown","source":"@ChatGPT off","metadata":{}},{"cell_type":"code","source":"#Buidling training, validation and test dataset\n\ntrain_ds = make_ds(train_seg_df, training=True)\nval_ds   = make_ds(val_seg_df, training=False)\ntest_ds  = make_ds(test_seg_df, training=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-21T09:41:54.136762Z","iopub.execute_input":"2025-12-21T09:41:54.137029Z","iopub.status.idle":"2025-12-21T09:41:54.221241Z","shell.execute_reply.started":"2025-12-21T09:41:54.137010Z","shell.execute_reply":"2025-12-21T09:41:54.220470Z"}},"outputs":[],"execution_count":44},{"cell_type":"markdown","source":"# 2.4 Model training #\n\nFor this project, we experimented with several neural network architectures to classify bird song spectrograms. We then trained and evaluated three main network architectures:\n\n**Convolutional Neural Network (CNN):**\n\nA baseline model consisting of multiple convolutional and pooling layers. Includes the regularization technique dropout to improve generalization. This model is easy to interpret and was used to verify that our preprocessing worked correctly before experimenting with more complicated architectures. \n\n**EfficientNetB0 (pre-trained):**\n\nEfficientNet is a pre-trained network with weights learned on Imagenet. This allows us to apply transfer learning so that the model can adapt its existing feature representations to the bird song classification task. The network was fine-tuned on the spectrogram dataset. EfficientNet is designed to deliver high accuracy while remaining computationally efficient. We used the smallest EfficientNetB0 to keep training time to a minimum before deciding what model to focus on. \n\n**ResNet50V2(pre-trained):**\n\nResNet50V2 is a pre-trained network with weights learned on Imagenet. Next to that, it used residual connections which allow for training deeper networks without degradation, improving feature extraction from complex audio patterns.\n\n**Loss function**\n\nAs a loss function we use the sparse categorical cross-entropy. This can be used when you have multiple classes that are coded in numbers (like 0,1,2,3) instead of one-hot encoding. Which is how we coded the labels of our dataset. \n\n**Key performance metric**\n\nAs key performance metric we use accuracy which is the percentage of correct classified samples. We chose this metric, because is easy to interpret and that makes it easier to evaluate our models. ","metadata":{}},{"cell_type":"markdown","source":"## 2.4.1 Early Stopping\n\nWe added early stopping to prevent overfitting. We also reduced the learning rate when the validation loss reached a plateau to optimalize our model. ","metadata":{}},{"cell_type":"code","source":" callbacks = [\n    EarlyStopping(\n        monitor=\"val_loss\",\n        patience=2,\n        restore_best_weights=True\n    ),\n    ReduceLROnPlateau(\n        monitor=\"val_loss\",\n        factor=0.5,\n        patience=2,\n        min_lr=1e-6\n    )\n]","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-21T09:42:16.159330Z","iopub.execute_input":"2025-12-21T09:42:16.160090Z","iopub.status.idle":"2025-12-21T09:42:16.163825Z","shell.execute_reply.started":"2025-12-21T09:42:16.160064Z","shell.execute_reply":"2025-12-21T09:42:16.163210Z"}},"outputs":[],"execution_count":45},{"cell_type":"markdown","source":"## 2.4.2 CNN ##\n\n### 2.4.2.1 Building","metadata":{}},{"cell_type":"code","source":"num_classes = train_df[\"label\"].nunique()\n\ndef build_cnn(num_classes):\n    inputs = keras.Input(shape=(128, 281, 3))\n\n    x = layers.Conv2D(32, 3, activation=\"relu\", padding=\"same\")(inputs)\n    x = layers.MaxPooling2D()(x)\n\n    x = layers.Conv2D(64, 3, activation=\"relu\", padding=\"same\")(x)\n    x = layers.MaxPooling2D()(x)\n\n    x = layers.Conv2D(128, 3, activation=\"relu\", padding=\"same\")(x)\n    x = layers.MaxPooling2D()(x)\n\n    # avoids needing a fixed flatten size\n    x = layers.GlobalAveragePooling2D()(x)\n\n    x = layers.Dense(256, activation=\"relu\")(x)\n    x = layers.Dropout(0.3)(x)\n\n    outputs = layers.Dense(num_classes, activation=\"softmax\")(x)\n    return keras.Model(inputs, outputs)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-21T11:54:23.783244Z","iopub.execute_input":"2025-12-21T11:54:23.784163Z","iopub.status.idle":"2025-12-21T11:54:23.790516Z","shell.execute_reply.started":"2025-12-21T11:54:23.784139Z","shell.execute_reply":"2025-12-21T11:54:23.789686Z"}},"outputs":[],"execution_count":59},{"cell_type":"markdown","source":"### 2.4.2.2 Compile & Fit","metadata":{}},{"cell_type":"code","source":"start = time.time()\n\ntrain_seg_df = expand_to_segments(train_df, path_col=\"filepath\", label_col=\"label\")\nval_seg_df   = expand_to_segments(val_df,   path_col=\"filepath\", label_col=\"label\")\ntest_seg_df = expand_to_segments(test_df, path_col=\"filepath\", label_col=\"label\")\n\ntrain_ds = make_ds(train_seg_df, training=True)\nval_ds   = make_ds(val_seg_df,   training=False)\ntest_ds     = make_ds(test_seg_df, training=False)\n\nmodel_cnn = build_cnn(num_classes)\nmodel_cnn.compile(\n    optimizer=tf.keras.optimizers.Adam(1e-3),\n    loss=tf.keras.losses.SparseCategorical