an has recording_id\nmeta_clean[\"recording_id\"] = meta_clean[\"filename\"].str.replace(\".ogg\", \"\", regex=False)\n\n# keep only (species, recording_id) pairs that passed your filters\nkeep = meta_clean[[\"primary_label\", \"recording_id\"]].drop_duplicates()\n\nbefore = len(images_df)\nimages_df = images_df.merge(keep, on=[\"primary_label\", \"recording_id\"], how=\"inner\").reset_index(drop=True)\nafter = len(images_df)\n\nprint(\"Before:\", before, \"After:\", after)\nprint(\"Species remaining:\", images_df[\"primary_label\"].nunique())\n\n\n# check\nshow(\"recording_id created\", meta_clean[[\"primary_label\", \"filename\", \"recording_id\"]])\n\nassert meta_clean[\"recording_id\"].str.contains(r\"\\.ogg$\").sum() == 0, \"recording_id still contains .ogg\"\nassert meta_clean[\"recording_id\"].notna().all(), \"Missing recording_id values\"","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-21T09:35:28.254450Z","iopub.execute_input":"2025-12-21T09:35:28.254722Z","iopub.status.idle":"2025-12-21T09:35:28.486037Z","shell.execute_reply.started":"2025-12-21T09:35:28.254705Z","shell.execute_reply":"2025-12-21T09:35:28.485449Z"}},"outputs":[{"name":"stdout","text":"Before: 463253 After: 463253\nSpecies remaining: 397\n\n✅ recording_id created\nshape: (62874, 3)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  primary_label      filename recording_id\n0        acafly  XC109605.ogg     XC109605\n1        acafly   XC11209.ogg      XC11209\n2        acafly  XC127032.ogg     XC127032","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>primary_label</th>\n      <th>filename</th>\n      <th>recording